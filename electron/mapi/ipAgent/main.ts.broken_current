    if (!fs.existsSync(settingsDir)) {
        fs.mkdirSync(settingsDir, { recursive: true });
    }
};

// 打开浏览器窗口并自动抓取数据
ipcMain.handle("ipAgent:openBrowserWindow", async (event, params: { url: string }) => {
    try {
        const { url } = params;

        Log.info("ipAgent.openBrowserWindow", { url });

        // 关闭之前的窗口（如果存在）
        if (browserWindow && !browserWindow.isDestroyed()) {
            browserWindow.close();
            browserWindow = null;
        }

        // Create new browser window - 隐藏Electron特征，防止抖音检测
        browserWindow = new BrowserWindow({
            width: 1200,
            height: 800,
            webPreferences: {
                nodeIntegration: false,
                contextIsolation: true,
                webSecurity: false,
                // 不使用预加载脚本，避免暴露Electron特征
                preload: undefined
            }
        });

        // 修改User-Agent，移除Electron标识
        browserWindow.webContents.setUserAgent(
            browserWindow.webContents.getUserAgent()
                .replace(/Electron\/[\d.]+\s/gi, '')
                .replace(/aigcpanel[^\s]*/gi, '')
        );

        browserWindow.loadURL(url);

        // 监听页面加载完成事件
        return new Promise((resolve) => {
            if (!browserWindow) {
                resolve({
                    success: false,
                    message: "Browser window creation failed"
                });
                return;
            }

            // 设置超时时间（30秒）
            const timeout = setTimeout(() => {
                Log.info("ipAgent.openBrowserWindow.timeout", { url });
                resolve({
                    success: false,
                    message: "页面加载超时，请检查网络连接或稍后重试"
                });
            }, 30000);

            // 监听页面加载完成
            browserWindow.webContents.on("did-finish-load", async () => {
                clearTimeout(timeout);

                Log.info("ipAgent.openBrowserWindow.pageLoaded", { url });

                // 等待3秒让页面完全渲染（抖音是动态加载的）
                await new Promise(r => setTimeout(r, 3000));

                try {
                    // 自动执行抓取脚本
                    const script = `
                        (async function() {
                            // 获取账号名称 - 多种尝试
                            let accountName = '';

                            // 尝试1: 查找包含nickname的元素
                            const nicknameEl = document.querySelector('[class*="nickname"], [class*="account"], h1');
                            if (nicknameEl) accountName = nicknameEl.textContent?.trim();

                            // 尝试2: 查找meta标签
                            if (!accountName) {
                                const metaEl = document.querySelector('meta[property="og:title"]');
                                if (metaEl) accountName = metaEl.getAttribute('content');
                            }

                            // 尝试3: 从URL或页面标题获取
                            if (!accountName) {
                                accountName = document.title.split('-')[0]?.trim() || '';
                            }

                            // 辅助函数：延迟等待
                            const sleep = (ms) => new Promise(r => setTimeout(r, ms));

                            // 等待元素出现（最多等待5秒）
                            const waitForElement = async (selector) => {
                                for (let i = 0; i < 10; i++) {
                                    const els = document.querySelectorAll(selector);
                                    if (els.length > 0) return els;
                                    await sleep(500);
                                }
                                return [];
                            };

                            // 方法1: 优先尝试结构化采集（从截图中确认这是存在的）
                            // 必须等待内容加载，因为抖音是动态渲染
                            let videoItems = await waitForElement('ul[data-e2e="scroll-list"] > li');
                            
                            // 排除词列表
                            const excludeWords = ['抖音号', 'IP属地', '获赞', '粉丝', '关注', '作品', '点赞', '评论', '分享', '收藏', '置顶'];
                            const videoTitles = [];

                            if (videoItems.length > 0) {
                                // 策略A: 结构化采集 (最准确，顺序绝对正确)
                                for (const item of videoItems) {
                                    if (videoTitles.length >= 6) break;
                                    
                                    // 在每个li中找标题p标签
                                    const pTags = item.querySelectorAll('p');
                                    
                                    for (const p of pTags) {
                                        const text = p.textContent?.trim();
                                        // 宽松的长度限制，适应短标题
                                        if (text && text.length >= 4) { 
                                            // 排除无关元素
                                            const hasExcludeWord = excludeWords.some(word => text.includes(word));
                                            if (hasExcludeWord) continue;

                                            // 检查是否为纯标签
                                            const textWithoutHashtags = text.replace(/#[^\s#]+/g, '').trim();
                                            if (textWithoutHashtags.length < 2 && !text.includes('棋')) continue; // 象棋视频可能字很少

                                            if (!videoTitles.includes(text)) {
                                                videoTitles.push(text);
                                                break; // 每个li只取第一个有效标题
                                            }
                                        }
                                    }
                                }
                            }

                            // 方法2: 如果结构化采集失败，回退到基于位置的采集
                            if (videoTitles.length < 3) {
                                // 查找所有p标签
                                const allPTags = document.querySelectorAll('p');
                                
                                // 收集带位置信息的候选标题
                                const titleCandidates = [];
                                
                                allPTags.forEach((el) => {
                                    const text = el.textContent?.trim();
                                    if (!text || text.length < 4) return; // 进一步降低长度限制

                                    const hasExcludeWord = excludeWords.some(word => text.includes(word));
                                    if (hasExcludeWord) return;
                                    
                                    const textWithoutHashtags = text.replace(/#[^\s#]+/g, '').trim();
                                    if (textWithoutHashtags.length < 2 && !text.includes('棋')) return;
                                    
                                    const rect = el.getBoundingClientRect();
                                    
                                    // 只要存在于文档流中
                                    titleCandidates.push({
                                        text: text,
                                        top: rect.top,
                                        left: rect.left
                                    });
                                });
                                
                                // 严格视觉排序：上->下 (阈值50px)，左->右
                                titleCandidates.sort((a, b) => {
                                    const yDiff = a.top - b.top;
                                    if (Math.abs(yDiff) > 50) return yDiff;
                                    return a.left - b.left;
                                });
                                
                                // 补充标题直到6个
                                for (const candidate of titleCandidates) {
                                    if (videoTitles.length >= 6) break;
                                    if (!videoTitles.includes(candidate.text)) {
                                        videoTitles.push(candidate.text);
                                    }
                                }
                            }

                            return {
                                accountName,
                                videoTitles: videoTitles.slice(0, 6)
                            };
                        })();
                    `;

                    const data = await browserWindow!.webContents.executeJavaScript(script);

                    Log.info("ipAgent.openBrowserWindow.scraped", {
                        accountName: data.accountName,
                        videoCount: data.videoTitles?.length || 0
                    });

                    // 关闭浏览器窗口
                    if (browserWindow && !browserWindow.isDestroyed()) {
                        browserWindow.close();
                        browserWindow = null;
                    }

                    resolve({
                        success: true,
                        data
                    });

                } catch (scrapeError) {
                    Log.error("ipAgent.openBrowserWindow.scrapeError", scrapeError);
                    resolve({
                        success: false,
                        message: "数据采集失败: " + (scrapeError?.message || scrapeError)
                    });
                }
            });

            browserWindow.on("closed", () => {
                clearTimeout(timeout);
                browserWindow = null;
            });
        });

    } catch (error) {
        Log.error("ipAgent.openBrowserWindow.error", error);
        return {
            success: false,
            message: "打开浏览器失败: " + (error?.message || error)
        };
    }
});

