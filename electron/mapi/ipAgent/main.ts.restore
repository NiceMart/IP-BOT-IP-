let browserWindow: BrowserWindow | null = null;

// 获取设置文件路径
const getSettingsFilePath = () => {
    return path.join(AppEnv.dataRoot, 'ipAgent', 'settings.json');
};

/**
 * 将文本按最大字符数分割成多行
 * 优化：优先在标点符号处分割，避免在词语中间分割
 */
function splitTextIntoLinesOptimized(text: string, maxCharsPerLine: number): string[] {
    const lines: string[] = [];
    let currentLine = '';

    // 按标点符号和空格分词，保留分隔符
    // 中文标点：，。！？、；：""''（）【】《》
    const words = text.split(/([，。！？、；：\s""''（）【】《》]+)/);

    for (const word of words) {
        if (!word.trim()) {
            // 保留标点符号和空格
            currentLine += word;
            continue;
        }

        // 如果当前行加上新词不超过限制，直接添加
        if ((currentLine + word).length <= maxCharsPerLine) {
            currentLine += word;
        } else {
            // 如果当前行不为空，先保存当前行
            if (currentLine.trim()) {
                lines.push(currentLine.trim());
            }
            
            // 如果单个词就超过限制，需要强制分割（这种情况很少见）
            if (word.length > maxCharsPerLine) {
                // 尝试在词中间分割（尽量避免，但必要时也要分割）
                let remainingWord = word;
                while (remainingWord.length > maxCharsPerLine) {
                    lines.push(remainingWord.substring(0, maxCharsPerLine));
                    remainingWord = remainingWord.substring(maxCharsPerLine);
                }
                currentLine = remainingWord;
            } else {
                currentLine = word;
            }
        }
    }

    // 添加最后一行
    if (currentLine.trim()) {
        lines.push(currentLine.trim());
    }

    return lines.length > 0 ? lines : [text];
}

// 确保设置目录存在
const ensureSettingsDir = () => {
    const settingsDir = path.join(AppEnv.dataRoot, 'ipAgent');
    if (!fs.existsSync(settingsDir)) {
        fs.mkdirSync(settingsDir, {recursive: true});
    }
};

// 打开浏览器窗口并自动抓取数据
ipcMain.handle("ipAgent:openBrowserWindow", async (event, params: {url: string}) => {
    try {
        const {url} = params;

        Log.info("ipAgent.openBrowserWindow", {url});

        // 关闭之前的窗口（如果存在）
        if (browserWindow && !browserWindow.isDestroyed()) {
            browserWindow.close();
            browserWindow = null;
        }

        // 创建新的浏览器窗口
        browserWindow = new BrowserWindow({
            width: 1200,
            height: 800,
            webPreferences: {
                nodeIntegration: false,
                contextIsolation: true,
                webSecurity: false
            }
        });

        browserWindow.loadURL(url);

        // 监听页面加载完成事件
        return new Promise((resolve) => {
            if (!browserWindow) {
                resolve({
                    success: false,
                    message: "浏览器窗口创建失败"
                });
                return;
            }

            // 设置超时时间（30秒）
            const timeout = setTimeout(() => {
                Log.info("ipAgent.openBrowserWindow.timeout", {url});
                resolve({
                    success: false,
                    message: "页面加载超时，请检查网络连接或稍后重试"
                });
            }, 30000);

            // 监听页面加载完成
            browserWindow.webContents.on("did-finish-load", async () => {
                clearTimeout(timeout);

                Log.info("ipAgent.openBrowserWindow.pageLoaded", {url});

                // 等待3秒让页面完全渲染（抖音是动态加载的）
                await new Promise(r => setTimeout(r, 3000));

                try {
                    // 自动执行抓取脚本
                    const script = `
                        (function() {
                            // 获取账号名称 - 多种尝试
                            let accountName = '';

                            // 尝试1: 查找包含nickname的元素
                            const nicknameEl = document.querySelector('[class*="nickname"], [class*="account"], h1');
                            if (nicknameEl) accountName = nicknameEl.textContent?.trim();

                            // 尝试2: 查找meta标签
                            if (!accountName) {
                                const metaEl = document.querySelector('meta[property="og:title"]');
                                if (metaEl) accountName = metaEl.getAttribute('content');
                            }

                            // 尝试3: 从URL或页面标题获取
                            if (!accountName) {
                                accountName = document.title.split('-')[0]?.trim() || '';
                            }

                            // 获取视频列表（最新5个）
                            const videoTitles = [];

                            // 方法1: 查找所有p标签，过滤出可能是标题的
                            const allPTags = document.querySelectorAll('p');
                            allPTags.forEach((el) => {
                                const text = el.textContent?.trim();
                                if (text && text.length > 15 && (text.includes('#') || text.includes('AI') || text.includes('超级'))) {
                                    if (videoTitles.length < 5 && !videoTitles.includes(text)) {
                                        videoTitles.push(text);
                                    }
                                }
                            });

                            // 方法2: 如果方法1没找到，尝试特定class
                            if (videoTitles.length === 0) {
                                const titleElements = document.querySelectorAll('p[class*="title"], p[class*="desc"], div[class*="title"]');
                                titleElements.forEach((el) => {
                                    if (videoTitles.length < 5) {
                                        const text = el.textContent?.trim();
                                        if (text && text.length > 10) {
                                            videoTitles.push(text);
                                        }
                                    }
                                });
                            }

                            return {
                                accountName,
                                videoTitles: videoTitles.slice(0, 5)
                            };
                        })();
                    `;

                    const data = await browserWindow!.webContents.executeJavaScript(script);

                    Log.info("ipAgent.openBrowserWindow.scraped", {
                        accountName: data.accountName,
                        videoCount: data.videoTitles?.length || 0
                    });

                    // 关闭浏览器窗口
                    if (browserWindow && !browserWindow.isDestroyed()) {
                        browserWindow.close();
                        browserWindow = null;
                    }

                    resolve({
                        success: true,
                        data
                    });

                } catch (scrapeError) {
                    Log.error("ipAgent.openBrowserWindow.scrapeError", scrapeError);
                    resolve({
                        success: false,
                        message: "数据采集失败: " + (scrapeError?.message || scrapeError)
                    });
                }
            });

            browserWindow.on("closed", () => {
                clearTimeout(timeout);
                browserWindow = null;
            });
        });

    } catch (error) {
        Log.error("ipAgent.openBrowserWindow.error", error);
        return {
            success: false,
            message: "打开浏览器失败: " + (error?.message || error)
        };
    }
});

// 从浏览器窗口抓取数据
ipcMain.handle("ipAgent:scrapeFromBrowser", async (event, params: {url: string}) => {
    try {
        const {url} = params;

        Log.info("ipAgent.scrapeFromBrowser", {url});

        if (!browserWindow) {
            return {
                success: false,
                message: "浏览器窗口未打开"
            };
        }

        // 执行JavaScript获取页面数据
        const script = `
            (function() {
                // 获取账号名称 - 多种尝试
                let accountName = '';

                // 尝试1: 查找包含nickname的元素
                const nicknameEl = document.querySelector('[class*="nickname"], [class*="account"], h1');
                if (nicknameEl) accountName = nicknameEl.textContent?.trim();

                // 尝试2: 查找meta标签
                if (!accountName) {
                    const metaEl = document.querySelector('meta[property="og:title"]');
                    if (metaEl) accountName = metaEl.getAttribute('content');
                }

                // 尝试3: 从URL或页面标题获取
                if (!accountName) {
                    accountName = document.title.split('-')[0]?.trim() || '';
                }

                // 获取视频列表（最新5个）
                // 抖音使用的class名是动态的，我们使用包含关键class片段的方式
                const videoTitles = [];

                // 方法1: 查找所有p标签，过滤出可能是标题的（长度>10且包含#标签）
                const allPTags = document.querySelectorAll('p');
                allPTags.forEach((el) => {
                    const text = el.textContent?.trim();
                    if (text && text.length > 15 && (text.includes('#') || text.includes('AI') || text.includes('超级'))) {
                        if (videoTitles.length < 5 && !videoTitles.includes(text)) {
                            videoTitles.push(text);
                        }
                    }
                });

                // 方法2: 如果方法1没找到，尝试特定class
                if (videoTitles.length === 0) {
                    const titleElements = document.querySelectorAll('p[class*="title"], p[class*="desc"], div[class*="title"]');
                    titleElements.forEach((el) => {
                        if (videoTitles.length < 5) {
                            const text = el.textContent?.trim();
                            if (text && text.length > 10) {
                                videoTitles.push(text);
                            }
                        }
                    });
                }

                return {
                    accountName,
                    videoTitles: videoTitles.slice(0, 5)
                };
            })();
        `;

        const data = await browserWindow.webContents.executeJavaScript(script);

        return {
            success: true,
            data
        };

    } catch (error) {
        Log.error("ipAgent.scrapeFromBrowser.error", error);
        return {
            success: false,
            message: "抓取失败: " + (error?.message || error)
        };
    }
});

