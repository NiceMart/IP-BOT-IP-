# Copy to .env locally; never commit a real .env.
APP_NAME=IP Bot
AUTH_SERVER_URL=http://127.0.0.1:3002
HOST=127.0.0.1
PORT=3002
# Keep blank to use the random secret generated by npm run init:local.
JWT_SECRET=
CORS_ORIGINS=http://127.0.0.1:3344,http://localhost:3344
# Optional: defaults to user-server/users.db, outside source control.
DATABASE_PATH=
# Cloud credentials are yours; blank values do not overwrite local JSON config.
ALIYUN_BAILIAN_API_KEY=
ALIYUN_BAILIAN_BASE_URL=https://dashscope.aliyuncs.com/api/v1
ALIYUN_OSS_ACCESS_KEY_ID=
ALIYUN_OSS_ACCESS_KEY_SECRET=
ALIYUN_OSS_BUCKET=
ALIYUN_OSS_REGION=oss-cn-beijing
VOLCENGINE_API_KEY=
VOLCENGINE_MODEL=
RUNNINGHUB_API_KEY=
