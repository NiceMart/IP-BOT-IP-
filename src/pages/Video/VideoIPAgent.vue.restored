                            >
                                {{ isGeneratingSubtitle ? t("处理中...") : t("自动生成字幕和BGM") }}
                            </a-button>

                            <!-- 最终视频预览 -->
                            <div v-if="finalVideoUrl" class="mt-3">
                                <div class="text-xs text-gray-600 mb-1">{{ t("最终视频预览") }}</div>
                                <div class="aspect-video bg-black rounded overflow-hidden">
                                    <VideoPlayer :key="finalVideoUrl" :url="'file://' + finalVideoUrl" />
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- 06 封面制作 -->
                <div class="bg-white rounded-lg shadow-sm border p-4">
                    <div class="flex items-center mb-3">
                        <div class="w-6 h-6 rounded-full bg-blue-500 text-white flex items-center justify-center text-sm font-bold mr-2">06</div>
                        <h3 class="text-sm font-bold">{{ t("封面制作") }}</h3>
                    </div>

                    <div class="space-y-2 mb-2">
                        <div class="flex items-center gap-2">
                            <a-button
                                type="primary"
                                block
                                size="small"
                                :loading="isGeneratingCover"
                                @click="generateCover"
                                :disabled="!videoPreviewUrl && !processedVideoUrl"
                            >
                                {{ isGeneratingCover ? t("生成中...") : t("自动生成封面") }}
                            </a-button>
                            <a-button
                                size="small"
                                @click="showCoverEffectDialog = true"
                            >
                                {{ t("效果") }}
                            </a-button>
                        </div>
                        <a-button
                            block
                            size="small"
                            @click="showCoverSettingsDialog = true"
                            :disabled="!videoPreviewUrl && !processedVideoUrl"
                        >
                            <template #icon>
                                <icon-settings />
                            </template>
                            {{ t("高级设置") }}
                        </a-button>
                        <div v-if="coverConfig.templateId" class="text-xs text-blue-600 px-2">
                            {{ t("已选模板") }}: {{ coverTemplateName }}
                        </div>
                    </div>
                    
                    <div class="mt-2 text-xs text-gray-600">{{ t("封面预览") }}</div>
                    <div v-if="coverPreviewUrl" 
                         class="aspect-video bg-black rounded mt-1 overflow-hidden cursor-pointer relative group"
                         @dblclick="showCoverImageDialog = true">
                        <img :src="'file://' + coverPreviewUrl" class="w-full h-full object-contain" />
                        <!-- 双击提示 -->
                        <div class="absolute inset-0 bg-black bg-opacity-0 group-hover:bg-opacity-30 transition-all duration-200 flex items-center justify-center opacity-0 group-hover:opacity-100">
                            <span class="text-white text-xs bg-black bg-opacity-50 px-2 py-1 rounded">{{ t("双击查看大图") }}</span>
                        </div>
                    </div>
                    <div v-else class="aspect-video bg-gray-100 rounded mt-1 flex items-center justify-center">
                        <span class="text-xs text-gray-400">{{ t("暂无封面预览") }}</span>
                    </div>
                </div>

                <!-- 07 视频发布 -->
                <div class="bg-white rounded-lg shadow-sm border p-4">
                    <div class="flex items-center mb-3">
                        <div class="w-6 h-6 rounded-full bg-blue-500 text-white flex items-center justify-center text-sm font-bold mr-2">07</div>
                        <h3 class="text-sm font-bold">{{ t("视频发布") }}</h3>
                    </div>

                    <div class="space-y-2">
                        <!-- 平台列表 -->
                        <div v-for="platform in [{name: '抖音', value: 'douyin'}, {name: '快手', value: 'kuaishou'}, {name: '视频号', value: 'shipin'}, {name: '小红书', value: 'xiaohongshu'}]" :key="platform.value" class="flex items-center justify-between p-2 bg-gray-50 rounded">
                            <a-checkbox v-model="publishPlatforms[platform.value].checked">
                                {{ t(platform.name) }}
                                <span v-if="publishPlatforms[platform.value].loggedIn" class="text-xs text-green-600 ml-1">
                                    ({{ publishPlatforms[platform.value].nickname || t('已登录') }})
                                </span>
                            </a-checkbox>
                            <a-button
                                size="mini"
                                :type="publishPlatforms[platform.value].loggedIn ? 'outline' : 'primary'"
                                @click="loginPlatform(platform.value)"
                            >
                                {{ publishPlatforms[platform.value].loggedIn ? t("已登录") : t("登录") }}
                            </a-button>
                        </div>
                        
                        <!-- 发布进度 -->
                        <div v-if="publishProgress" class="text-xs text-blue-600 p-2 bg-blue-50 rounded">
                            {{ publishProgress }}
                        </div>
                        
                        <!-- 发布结果 -->
                        <div v-if="publishResults.length > 0" class="space-y-1 max-h-32 overflow-y-auto">
                            <div v-for="(result, index) in publishResults" :key="index"
                                 class="text-xs p-2 rounded"
                                 :class="result.success ? 'bg-green-50 text-green-700' : 'bg-red-50 text-red-700'">
                                <div class="font-medium">{{ result.platform }}</div>
                                <div>{{ result.message }}</div>
                                <div v-if="result.videoUrl" class="text-blue-600 truncate">{{ result.videoUrl }}</div>
                            </div>
                        </div>
                        
                        <!-- 发布按钮 -->
                        <a-button
                            type="primary"
                            block
                            size="small"
                            class="mt-3"
                            :loading="isPublishing"
                            @click="publishVideo"
                        >
                            {{ isPublishing ? t("发布中...") : t("发布") }}
                        </a-button>
                    </div>
                </div>
            </div>
        </div>

        <!-- 添加IP大脑弹窗 -->
        <a-modal
            v-model:visible="showAddIPDialog"
            :title="t('添加IP大脑')"
            @ok="startAutoScrape"
            @cancel="showAddIPDialog = false"
            :ok-text="t('开始采集')"
            :cancel-text="t('取消')"
            :ok-loading="isAnalyzing"
            width="600px"
        >
            <div class="space-y-4">
                <div>
                    <label class="block mb-2 font-medium">{{ t("抖音账号链接") }}</label>
                    <a-input
                        v-model="douyinUrl"
                        :placeholder="t('请输入抖音账号链接，例如：https://www.douyin.com/user/...')"
                        size="large"
                    />
                    <div class="text-xs text-gray-500 mt-2">
                        {{ t("程序将自动打开浏览器，识别该账号信息，并采集最新5个视频标题") }}
                    </div>
                </div>
                <div class="bg-blue-50 p-3 rounded">
                    <div class="text-sm text-blue-900">
                        <div class="font-medium mb-1">{{ t("提示") }}:</div>
                        <ul class="list-disc list-inside space-y-1">
                            <li>{{ t("输入抖音账号链接后点击「开始采集」按钮") }}</li>
                            <li>{{ t("系统会自动打开浏览器并抓取数据，请保持网络连接正常") }}</li>
                            <li>{{ t("无需任何手动操作，等待采集完成即可") }}</li>
                            <li>{{ t("采集完成后会自动将5个视频标题添加到选题库中") }}</li>
                        </ul>
                    </div>
                </div>
            </div>
        </a-modal>

        <!-- 设置对话框 - 使用标签页 -->
        <a-modal
            v-model:visible="showSettingsDialog"
            :title="t('IP智能体设置')"
            @ok="saveSettings"
            @cancel="showSettingsDialog = false"
            :ok-text="t('保存')"
            :cancel-text="t('取消')"
            width="1000px"
        >
            <div v-if="showSettingsDialog" class="max-h-[70vh] overflow-y-auto">
                <a-tabs default-active-key="model" type="card">
                    <!-- 模型设置标签页 -->
                    <a-tab-pane key="model" :title="t('模型设置')">
                        <div class="space-y-4 p-4">
                            <!-- 文本模型 -->
                            <div>
                                <label class="block mb-2 text-sm font-medium">{{ t("文本模型") }}</label>
                                <ModelSelector v-model="settings.textModelKey" />
                            </div>

                            <!-- 声音模型 -->
                            <div>
                                <label class="block mb-2 text-sm font-medium">{{ t("声音模型（声音克隆）") }}</label>
                                <ServerSelector
                                    v-model="settings.voiceModelKey"
                                    functionName="soundClone"
                                    :key="`voice-${showSettingsDialog}`"
                                />
                            </div>

                            <!-- 声音音色 -->
                            <div>
                                <label class="block mb-2 text-sm font-medium">{{ t("声音音色") }}</label>
                                <SoundPromptSelector v-model="settings.voicePromptId" />
                            </div>

                            <!-- 语音识别模型 -->
                            <div>
                                <label class="block mb-2 text-sm font-medium">{{ t("语音识别模型") }}</label>
                                <ServerSelector
                                    v-model="settings.asrModelKey"
                                    functionName="asr"
                                    :key="`asr-${showSettingsDialog}`"
                                />
                            </div>
                        </div>
                    </a-tab-pane>

                    <!-- 提示词设置标签页 -->
                    <a-tab-pane key="prompts" :title="t('提示词设置')">
                        <div class="space-y-4 p-4">
                            <!-- 生成文案提示词 -->
                            <div>
                                <label class="block mb-2 text-sm font-medium">{{ t("生成文案提示词") }}</label>
                                <a-textarea
                                    v-model="settings.scriptPrompt"
                                    :rows="6"
                                    :placeholder="t('输入生成文案的提示词...')"
                                />
                                <div class="text-xs text-gray-500 mt-1">
                                    {{ t("可用变量：{title}、{count}") }}
                                </div>
                            </div>

                            <!-- 标题标签关键词提示词 -->
                            <div>
                                <label class="block mb-2 text-sm font-medium">{{ t("标题标签关键词提示词") }}</label>
                                <a-textarea
                                    v-model="settings.titleTagPrompt"
                                    :rows="6"
                                    :placeholder="t('输入标题标签关键词生成的提示词...')"
                                />
                                <div class="text-xs text-gray-500 mt-1">
                                    {{ t("可用变量：") + '\u007B\u007Bcontent\u007D\u007D' }}
                                </div>
                            </div>

                            <!-- 选题库仿写提示词 -->
                            <div>
                                <label class="block mb-2 text-sm font-medium">{{ t("选题库仿写提示词") }}</label>
                                <a-textarea
                                    v-model="settings.topicRewritePrompt"
                                    :rows="6"
                                    :placeholder="t('输入选题库标题仿写的提示词...')"
                                />
                                <div class="text-xs text-gray-500 mt-1">
                                    {{ t("用于一键仿写选题库标题，可用变量：") + '\u007B\u007Bcontent\u007D\u007D' }}
                                </div>
                            </div>

                            <!-- 仿写提示词 -->
                            <div>
                                <label class="block mb-2 text-sm font-medium">{{ t("仿写提示词") }}</label>
                                <a-textarea
                                    v-model="settings.rewritePrompt"
                                    :rows="5"
                                    :placeholder="t('输入仿写的提示词...')"
                                />
                                <div class="text-xs text-gray-500 mt-1">
                                    {{ t("可用变量：") + '\u007B\u007Bcontent\u007D\u007D、\u007B\u007Bcount\u007D\u007D' }}
                                </div>
                            </div>
                        </div>
                    </a-tab-pane>

                    <!-- 字幕设置标签页 -->
                    <a-tab-pane key="subtitle" :title="t('字幕设置')">
                        <div class="space-y-4 p-4">
                            <!-- 字幕模式选择 -->
                            <div class="p-4 bg-blue-50 rounded-lg border border-blue-200">
                                <div class="flex items-center justify-between mb-3">
                                    <h5 class="font-medium text-base">{{ t("字幕模式") }}</h5>
                                    <a-switch v-model="settings.enableSentimentAnalysis">
                                        <template #checked>{{ t("情感分析") }}</template>
                                        <template #unchecked>{{ t("基础模式") }}</template>
                                    </a-switch>
                                </div>
                                <div class="text-xs text-gray-600">
                                    <div v-if="settings.enableSentimentAnalysis" class="text-blue-700">
                                        ✨ {{ t("情感分析模式：AI自动分析文案情感，为不同词语添加智能特效（颜色、动画、缩放等）") }}
                                    </div>
                                    <div v-else class="text-gray-600">
                                        📝 {{ t("基础模式：使用传统字幕样式和关键词特效") }}
                                    </div>
                                </div>
                            </div>

                            <!-- 情感分析字幕配置（仅在启用时显示） -->
                            <div v-if="settings.enableSentimentAnalysis" class="space-y-4 pl-4 border-l-2 border-blue-300">
                                <!-- 基础字幕样式（情感字幕也需要） -->
                                <div class="p-3 bg-blue-50 rounded-lg border border-blue-200">
                                    <h5 class="font-medium mb-3 text-sm">{{ t("基础字幕样式") }}</h5>
                                    <div class="text-xs text-gray-600 mb-3">
                                        {{ t("设置字幕的基础样式（字体、大小、描边等），情感特效会在此基础上叠加") }}
                                    </div>
                                    <SubtitleStyleSelector
                                        v-model="selectedSubtitleStyleId"
                                        v-model:fontSizeScale="subtitleFontSizeScale"
                                        v-model:subtitlePosition="subtitlePosition"
                                        ref="subtitleStyleSelectorRef"
                                    />
                                </div>

                                <a-divider />

                                <!-- 情感分析模型 -->
                                <div>
                                    <label class="block mb-2 text-sm font-medium">{{ t("情感分析模型") }}</label>
                                    <ModelSelector v-model="settings.sentimentModelKey" />
                                    <div class="text-xs text-gray-500 mt-1">
                                        {{ t("推荐使用：智谱AI GLM-4-Flash（速度快、准确度高）") }}
                                    </div>
                                </div>

                                <!-- 情感字幕模板 -->
                                <div>
                                    <label class="block mb-2 text-sm font-medium">{{ t("情感字幕模板") }}</label>
                                    <a-select v-model="settings.sentimentTemplate" class="w-full">
                                        <a-option value="auto">{{ t("自动模式 - 根据情感自动变化") }}</a-option>
                                        <a-option value="rainbow">{{ t("情感彩虹 - 多彩渐变效果") }}</a-option>
                                        <a-option value="pulse">{{ t("情感脉冲 - 动态强度变化") }}</a-option>
                                        <a-option value="douyin">{{ t("抖音风格 - 粗体白字黑边") }}</a-option>
                                        <a-option value="kuaishou">{{ t("快手风格 - 醒目大字") }}</a-option>
                                        <a-option value="minimal">{{ t("简约风格 - 简洁清爽") }}</a-option>
                                    </a-select>
                                    <div class="text-xs text-gray-500 mt-1">
                                        {{ t("不同模板提供不同的视觉风格和特效强度") }}
                                    </div>
                                </div>

                                <!-- 特效强度 -->
                                <div>
                                    <label class="block mb-2 text-sm font-medium">{{ t("特效强度") }} ({{ settings.sentimentEffectIntensity }}%)</label>
                                    <a-slider
                                        v-model="settings.sentimentEffectIntensity"
                                        :min="0"
                                        :max="100"
                                        :default-value="70"
                                        :marks="{0: '弱', 50: '中', 100: '强'}"
                                    />
                                    <div class="text-xs text-gray-500 mt-1">
                                        {{ t("控制缩放、发光等特效的强度") }}
                                    </div>
                                </div>

                                <!-- 启用动画 -->
                                <div>
                                    <a-checkbox v-model="settings.enableSentimentAnimation">
                                        {{ t("启用动画效果") }}
                                    </a-checkbox>
                                    <div class="text-xs text-gray-500 mt-1 ml-5">
                                        {{ t("为强调词、动作词等添加弹跳、发光等动画效果") }}
                                    </div>
                                </div>

                                <!-- 情感颜色配置 -->
                                <div>
                                    <label class="block mb-2 text-sm font-medium">{{ t("情感颜色配置") }}</label>
                                    <div class="text-xs text-gray-600 mb-2">
                                        {{ t("配置不同情感类型的颜色，会覆盖基础字幕颜色") }}
                                    </div>
                                    <div class="grid grid-cols-2 gap-3">
                                        <div class="flex items-center gap-2">
                                            <span class="text-xs w-12">{{ t("正面") }}</span>
                                            <input type="color" v-model="settings.sentimentColors.positive" class="w-12 h-8 rounded cursor-pointer border" />
                                            <span class="text-xs text-gray-500 font-mono">{{ settings.sentimentColors.positive }}</span>
                                        </div>
                                        <div class="flex items-center gap-2">
                                            <span class="text-xs w-12">{{ t("负面") }}</span>
                                            <input type="color" v-model="settings.sentimentColors.negative" class="w-12 h-8 rounded cursor-pointer border" />
                                            <span class="text-xs text-gray-500 font-mono">{{ settings.sentimentColors.negative }}</span>
                                        </div>
                                        <div class="flex items-center gap-2">
                                            <span class="text-xs w-12">{{ t("中性") }}</span>
                                            <input type="color" v-model="settings.sentimentColors.neutral" class="w-12 h-8 rounded cursor-pointer border" />
                                            <span class="text-xs text-gray-500 font-mono">{{ settings.sentimentColors.neutral }}</span>
                                        </div>
                                        <div class="flex items-center gap-2">
                                            <span class="text-xs w-12">{{ t("强调") }}</span>
                                            <input type="color" v-model="settings.sentimentColors.emphasis" class="w-12 h-8 rounded cursor-pointer border" />
                                            <span class="text-xs text-gray-500 font-mono">{{ settings.sentimentColors.emphasis }}</span>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <!-- 基础字幕配置（仅在未启用情感分析时显示） -->
                            <div v-else class="space-y-4">
                                <!-- 基础字幕样式 -->
                                <div>
                                    <h5 class="font-medium mb-3">{{ t("基础字幕样式") }}</h5>
                                    <SubtitleStyleSelector
                                        v-model="selectedSubtitleStyleId"
                                        v-model:fontSizeScale="subtitleFontSizeScale"
                                        v-model:subtitlePosition="subtitlePosition"
                                        ref="subtitleStyleSelectorRef"
                                    />
                                </div>

                                <a-divider />

                                <!-- 关键词特效 -->
                                <div>
                                    <div class="flex items-center justify-between mb-3">
                                        <h5 class="font-medium">{{ t("关键词特效") }}</h5>
                                        <a-switch v-model="enableKeywordEffects">
                                            <template #checked>{{ t("开启") }}</template>
                                            <template #unchecked>{{ t("关闭") }}</template>
                                        </a-switch>
                                    </div>
                                    <div class="text-xs text-gray-500 mb-3">
                                        {{ t("AI自动识别字幕中的关键词并添加醒目的放大特效") }}
                                    </div>

                                    <div v-if="enableKeywordEffects">
                                        <KeywordEffectSelector ref="keywordEffectSelectorRef" />
                                    </div>
                                </div>

                                <a-divider />

                                <!-- 字幕高亮词 -->
                                <div>
                                    <label class="block mb-2 text-sm font-medium">{{ t("字幕高亮词") }}</label>
                                    <a-textarea
                                        v-model="settings.subtitleHighlightWords"
                                        :rows="3"
                                        :placeholder="t('输入需要高亮的关键词，每行一个...')"
                                    />
                                    <div class="text-xs text-gray-500 mt-1">
                                        {{ t("这些关键词将在字幕中以特殊样式显示") }}
                                    </div>
                                </div>
                            </div>
                        </div>
                    </a-tab-pane>

                    <!-- 其他设置标签页 -->
                    <a-tab-pane key="other" :title="t('其他设置')">
                        <div class="space-y-4 p-4">
                            <!-- 背景音乐目录 -->
                            <div>
                                <label class="block mb-2 text-sm font-medium">{{ t("背景音乐目录") }}</label>
                                <div class="flex gap-2">
                                    <a-input
                                        v-model="settings.bgmDirectory"
                                        :placeholder="t('未选择')"
                                        readonly
                                        class="flex-1"
                                    />
                                    <a-button @click="selectBgmDirectory">
                                        {{ t("选择目录") }}
                                    </a-button>
                                </div>
                                <div class="text-xs text-gray-500 mt-1">
                                    {{ t("未选择或目录无音频时，将自动使用项目内置音乐") }}
                                </div>
                            </div>
                        </div>
                    </a-tab-pane>
                </a-tabs>
            </div>
        </a-modal>

        <!-- 字幕样式选择对话框 -->
        <a-modal
            v-model:visible="showSubtitleStyleDialog"
            :title="t('字幕样式与特效配置')"
            @ok="showSubtitleStyleDialog = false"
            @cancel="showSubtitleStyleDialog = false"
            :ok-text="t('确定')"
            :cancel-text="t('取消')"
            width="900px"
        >
            <div class="space-y-6 max-h-[70vh] overflow-y-auto">
                <!-- 字幕来源说明 -->
                <div class="p-4 bg-blue-50 rounded-lg border border-blue-200">
                    <div class="flex items-center gap-2 text-blue-800">
                        <icon-info-circle />
                        <span class="font-medium">{{ t("字幕将通过 FUNASR 自动识别生成") }}</span>
                    </div>
                    <div class="text-xs text-blue-600 mt-1 ml-6">
                        {{ t("点击「自动生成字幕和BGM」按钮后，系统会自动进行语音识别并生成精准同步的字幕") }}
                    </div>
                </div>

                <!-- 基础字幕样式 -->
                <div>
                    <h5 class="font-medium mb-3">{{ t("基础字幕样式") }}</h5>
                    <SubtitleStyleSelector
                        v-model="selectedSubtitleStyleId"
                        v-model:fontSizeScale="subtitleFontSizeScale"
                        v-model:subtitlePosition="subtitlePosition"
                        ref="subtitleStyleSelectorRef"
                    />
                </div>

                <!-- 关键词识别与特效 -->
                <div class="p-4 bg-gradient-to-r from-blue-50 to-purple-50 rounded-lg border border-blue-200">
                    <div class="mb-3">
                        <div class="flex items-center gap-3">
                            <a-checkbox v-model="enableKeywordEffects">
                                <h5 class="font-medium">{{ t("关键词智能识别与特效") }}</h5>
                            </a-checkbox>
                            <a-tag v-if="!enableKeywordEffects" color="gray" size="small">{{ t("未启用") }}</a-tag>
                            <a-tag v-else color="blue" size="small">{{ t("已启用") }}</a-tag>
                        </div>
                        <div class="text-xs text-gray-600 mt-1 ml-6">
                            {{ t("勾选后启用关键词特效功能，AI自动识别字幕中的关键词并添加醒目的放大特效") }}
                        </div>
                    </div>

                    <div v-if="enableKeywordEffects" class="mt-4 space-y-4">
                        <!-- 关键词自动识别说明 -->
                        <div class="flex items-center gap-2 p-3 bg-blue-50 rounded border border-blue-200">
                            <icon-info-circle class="text-blue-500" />
                            <span class="text-xs text-blue-700">
                                {{ t("关键词将根据字幕内容自动识别和匹配，生成视频时会自动应用特效") }}
                            </span>
                        </div>

                        <!-- 关键词特效选择器 -->
                        <div>
                            <KeywordEffectSelector ref="keywordEffectSelectorRef" />
                        </div>

                        <!-- 关键词标记管理 -->
                        <div v-if="extractedKeywords.length > 0">
                            <KeywordMarker
                                ref="keywordMarkerRef"
                                :keywords="extractedKeywords"
                                :subtitle-segments="funasrSegments"
                                @markers-change="onMarkersChange"
                            />
                        </div>
                    </div>
                </div>

                <!-- 视频顶部固定标题 -->
                <div class="p-4 bg-gradient-to-r from-yellow-50 to-orange-50 rounded-lg border border-orange-200">
                    <div class="mb-3">
                        <div class="flex items-center gap-3 justify-between">
                            <div>
                                <div class="flex items-center gap-2">
                                    <h5 class="font-medium">{{ t("视频顶部固定标题") }}</h5>
                                    <a-tag color="orange" size="small">{{ t("新功能") }}</a-tag>
                                </div>
                                <div class="text-xs text-gray-600 mt-1">
                                    {{ t("在视频顶部固定显示生成的标题，类似抖音置顶文字效果") }}
                                </div>
                            </div>
                            <a-switch v-model="enableTopTitle" size="small">
                                <template #checked>开启</template>
                                <template #unchecked>关闭</template>
                            </a-switch>
                        </div>
                    </div>

                    <div v-if="enableTopTitle" class="mt-4 space-y-4">
                        <!-- 标题文本预览 -->
                        <div class="p-3 bg-white rounded-lg border">
                            <label class="text-sm text-gray-600 mb-2 block">{{ t("标题内容") }}</label>
                            <div class="text-sm text-gray-700 p-2 bg-gray-50 rounded">
                                {{ generatedTitle || t('标题将在生成后自动显示') }}
                            </div>
                        </div>

                        <!-- 样式设置 -->
                        <div class="p-4 bg-white rounded-lg border">
                            <h6 class="font-medium text-sm mb-3">{{ t("标题样式设置") }}</h6>

                            <div class="grid grid-cols-2 gap-4">
                                <!-- 字体大小 -->
                                <div>
                                    <label class="text-sm text-gray-600 mb-1 block">{{ t("字体大小") }}</label>
                                    <div class="flex items-center gap-2">
                                        <a-slider
                                            v-model="topTitleStyle.fontSize"
                                            :min="24"
                                            :max="80"
                                            :step="4"
                                            class="flex-1"
                                        />
                                        <span class="text-sm font-mono w-12 text-right">{{ topTitleStyle.fontSize }}px</span>
                                    </div>
                                </div>

                                <!-- 文字颜色 -->
                                <div>
                                    <label class="text-sm text-gray-600 mb-1 block">{{ t("文字颜色") }}</label>
                                    <div class="flex items-center gap-2">
                                        <a-color-picker v-model="topTitleStyle.fontColor" />
                                        <a-input v-model="topTitleStyle.fontColor" class="flex-1" size="small" />
                                    </div>
                                </div>

                                <!-- 背景颜色 -->
                                <div>
                                    <label class="text-sm text-gray-600 mb-1 block">{{ t("背景颜色") }}</label>
                                    <div class="flex items-center gap-2">
                                        <a-color-picker v-model="topTitleStyle.backgroundColor" />
                                        <a-input v-model="topTitleStyle.backgroundColor" class="flex-1" size="small" />
                                    </div>
                                </div>

                                <!-- 背景透明度 -->
                                <div>
                                    <label class="text-sm text-gray-600 mb-1 block">{{ t("背景透明度") }}</label>
                                    <div class="flex items-center gap-2">
                                        <a-slider
                                            v-model="topTitleStyle.backgroundOpacity"
                                            :min="0"
                                            :max="1"
                                            :step="0.1"
                                            class="flex-1"
                                        />
                                        <span class="text-sm font-mono w-12 text-right">{{ Math.round(topTitleStyle.backgroundOpacity * 100) }}%</span>
                                    </div>
                                </div>

                                <!-- 圆角大小 -->
                                <div>
                                    <label class="text-sm text-gray-600 mb-1 block">{{ t("圆角大小") }}</label>
                                    <div class="flex items-center gap-2">
                                        <a-slider
                                            v-model="topTitleStyle.borderRadius"
                                            :min="0"
                                            :max="30"
                                            :step="2"
                                            class="flex-1"
                                        />
                                        <span class="text-sm font-mono w-12 text-right">{{ topTitleStyle.borderRadius }}px</span>
                                    </div>
                                </div>

                                <!-- 内边距 -->
                                <div>
                                    <label class="text-sm text-gray-600 mb-1 block">{{ t("内边距") }}</label>
                                    <div class="flex items-center gap-2">
                                        <a-slider
                                            v-model="topTitleStyle.paddingVertical"
                                            :min="5"
                                            :max="30"
                                            :step="5"
                                            class="flex-1"
                                        />
                                        <span class="text-sm font-mono w-12 text-right">{{ topTitleStyle.paddingVertical }}px</span>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- 效果预览 -->
                        <div class="p-4 bg-gray-800 rounded-lg">
                            <div class="text-xs text-gray-400 mb-2 text-center">{{ t("效果预览") }}</div>
                            <div class="flex justify-center items-start pt-4">
                                <div
                                    class="inline-block px-6 py-3 font-bold text-center"
                                    :style="{
                                        fontSize: topTitleStyle.fontSize + 'px',
                                        color: topTitleStyle.fontColor,
                                        backgroundColor: topTitleStyle.backgroundColor,
                                        opacity: topTitleStyle.backgroundOpacity,
                                        borderRadius: topTitleStyle.borderRadius + 'px',
                                        padding: `${topTitleStyle.paddingVertical}px ${topTitleStyle.paddingHorizontal}px`
                                    }"
                                >
                                    {{ generatedTitle || '特斯拉机器揭秘\n数据难出优势' }}
                                </div>
                            </div>
                        </div>

                        <!-- 快速预设 -->
                        <div>
                            <label class="text-sm text-gray-600 mb-2 block">{{ t("快速预设") }}</label>
                            <div class="flex gap-2 flex-wrap">
                                <a-button
                                    size="small"
                                    @click="() => {
                                        topTitleStyle.fontColor = '#FFD700';
                                        topTitleStyle.backgroundColor = '#000000';
                                        topTitleStyle.backgroundOpacity = 0.7;
                                    }"
                                >
                                    金色经典
                                </a-button>
                                <a-button
                                    size="small"
                                    @click="() => {
                                        topTitleStyle.fontColor = '#FFFFFF';
                                        topTitleStyle.backgroundColor = '#FF0000';
                                        topTitleStyle.backgroundOpacity = 0.8;
                                    }"
                                >
                                    红色醒目
                                </a-button>
                                <a-button
                                    size="small"
                                    @click="() => {
                                        topTitleStyle.fontColor = '#FFFFFF';
                                        topTitleStyle.backgroundColor = '#FF69B4';
                                        topTitleStyle.backgroundOpacity = 0.85;
                                    }"
                                >
                                    粉色可爱
                                </a-button>
                                <a-button
                                    size="small"
                                    @click="() => {
                                        topTitleStyle.fontColor = '#000000';
                                        topTitleStyle.backgroundColor = '#FFEB3B';
                                        topTitleStyle.backgroundOpacity = 0.9;
                                    }"
                                >
                                    黄色活力
                                </a-button>
                                <a-button
                                    size="small"
                                    @click="() => {
                                        topTitleStyle.fontColor = '#FFFFFF';
                                        topTitleStyle.backgroundColor = '#00BFFF';
                                        topTitleStyle.backgroundOpacity = 0.8;
                                    }"
                                >
                                    蓝色清爽
                                </a-button>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </a-modal>

        <!-- 封面样式自定义对话框 -->
        <a-modal
            v-model:visible="showCoverEffectDialog"
            :title="t('封面样式自定义')"
            width="900px"
            :mask-closable="false"
        >
            <CoverEffectSelector
                ref="coverEffectSelectorRef"
                :cover-style="coverStyle"
                @style-change="(style) => { 
                    coverStyle = style;
                    console.log('封面样式变化:', style); 
                }"
            />
            
            <template #footer>
                <a-button @click="showCoverEffectDialog = false">{{ t("关闭") }}</a-button>
            </template>
        </a-modal>

        <!-- 封面图片预览弹窗 -->
        <a-modal
            v-model:visible="showCoverImageDialog"
            :title="$t('封面预览')"
            width="80%"
            :footer="false"
            @cancel="showCoverImageDialog = false"
        >
            <div v-if="coverPreviewUrl" class="flex justify-center bg-gray-100 rounded-lg p-4">
                <img 
                    :src="'file://' + coverPreviewUrl" 
                    :alt="$t('封面图片')" 
                    class="max-w-full max-h-[80vh] object-contain shadow-lg rounded-lg"
                />
            </div>
            <div v-else class="text-center py-8 text-gray-400">
                {{ $t("暂无封面图片") }}
            </div>
        </a-modal>
        
        <!-- 封面高级设置对话框 -->
        <CoverSettingsDialog
            v-model:visible="showCoverSettingsDialog"
            v-model:config="coverConfig"
            v-model:template-name="coverTemplateName"
            :video-path="videoPreviewUrl || processedVideoUrl || ''"
            :reference-text="generatedTitle"
            @apply="handleCoverConfigApply"
        />
    </div>
</template>

