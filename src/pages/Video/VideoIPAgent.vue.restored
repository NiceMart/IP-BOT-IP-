    voicePromptId: 0,
    // 语音识别模型 (serverKey)
    asrModelKey: "",
    // 生成文案提示词
    scriptPrompt: `你是一个视频口播专家，擅长根据用户给的主题和关键词生成高质量的口播稿件。
请根据以下要求生成口播稿件：

1. 主题：{title}
2. 字数：大约{count}字

请确保稿件内容连贯、有吸引力，并且符合口播的风格。
请直接输出生成的口播稿件，无需任何额外说明文字。

可用变量：{title}、{count}`,
    // 标题标签关键词提示词
    titleTagPrompt: `你是短视频标题、标签与关键词助手。请基于提供的口播文案，生成一个中文标题、3-4个中文标签和3-5个关键词，要求如下：
- 标题不超过15个字，简洁有吸引力，不加引号，不含表情或图标字符。
- 标签为2-6个字的中文短词，不含#、空格和表情；以主题词为主，避免冗长句。
- 关键词为文案中的核心词汇，用于字幕高亮特效，每个关键词2-4个字。
- 直接输出纯JSON格式，不要使用markdown代码块（不要用\`\`\`json），不要附加任何说明文字。
- 输出格式：{"title":"...", "tags":["...","...","...","..."], "keywords":["...","...","..."]}
文案：<content>{{content}}</content>
直接输出JSON，不要任何额外内容。
可用变量：{{content}}`,
    // 选题库仿写提示词
    topicRewritePrompt: `参考以下标题，帮我生成5个新的标题。

参考标题：
{{content}}

要求：
1. 保持相似的主题和风格
2. 标题简洁有力，吸引眼球
3. 不要添加表情符号和#标签
4. 每个标题独立成行

请直接输出5个新标题，不要编号和额外说明。
可用变量：{{content}}`,
    // 仿写提示词(用于单条内容仿写)
    rewritePrompt: `你是短视频文案仿写助手。请基于以下文本进行风格仿写，保留核心信息，不增加表情或特殊符号，输出约{{count}}字。

原文：
{{content}}

仅输出仿写后的文本，不要解释，不要包含多余符号。
可用变量：{{content}}、{{count}}`,
    // 字幕高亮词
    subtitleHighlightWords: "",
    // 背景音乐目录
    bgmDirectory: "",
    // 情感分析设置
    enableSentimentAnalysis: false,           // 是否启用情感分析
    sentimentModelKey: 'zhipu|glm-4-flash',  // 情感分析模型
    sentimentTemplate: 'auto',                // 情感字幕模板
    sentimentEffectIntensity: 70,            // 特效强度 0-100
    enableSentimentAnimation: true,           // 是否启用动画
    sentimentColors: {                        // 情感颜色配置
        positive: '#00FF00',   // 正面-绿色
        negative: '#FF0000',   // 负面-红色
        neutral: '#FFFFFF',    // 中性-白色
        emphasis: '#FFFF00'    // 强调-黄色
    }
});

// 情感分析器实例（懒加载）
let sentimentAnalyzer: SentimentAnalyzer | null = null;
let effectGenerator: EffectGenerator | null = null;

// 初始化情感分析器
const initSentimentAnalyzer = () => {
    if (!sentimentAnalyzer && settings.value.enableSentimentAnalysis) {
        try {
            console.log("开始初始化情感分析器...");
            
            // 解析模型配置
            const [providerId, modelId] = settings.value.sentimentModelKey.split('|');
            console.log("模型配置:", { providerId, modelId });
            
            sentimentAnalyzer = new SentimentAnalyzer({
                useAI: true,
                providerId: providerId || 'zhipu',
                modelId: modelId || 'glm-4-flash',
                fallbackToLexicon: true,
                cacheResults: true
            });
            console.log("SentimentAnalyzer 创建成功");
            
            // 创建特效生成器
            effectGenerator = new EffectGenerator({
                colors: {
                    positive: settings.value.sentimentColors.positive,
                    negative: settings.value.sentimentColors.negative,
                    neutral: settings.value.sentimentColors.neutral,
                    emphasis: settings.value.sentimentColors.emphasis,
                    action: '#FF8800',
                    emotion: '#FF00FF'
                },
                intensity: {
                    minScale: 0.9,
                    maxScale: 1.0 + (settings.value.sentimentEffectIntensity / 100),
                    minAlpha: 0,
                    maxAlpha: 255,
                    minBlur: 0,
                    maxBlur: settings.value.sentimentEffectIntensity / 50
                },
                enableGlow: true,
                enableAnimation: settings.value.enableSentimentAnimation,
                animationDuration: 300
            });
            console.log("EffectGenerator 创建成功");
            console.log("情感分析器初始化完成");
        } catch (error) {
            console.error("初始化情感分析器失败:", error);
            sentimentAnalyzer = null;
            effectGenerator = null;
            throw error;
        }
    }
};

// 打开设置对话框
const openSettingsDialog = async () => {
    // 等待 serverStore 初始化完成
    await serverStore.waitReady();
    showSettingsDialog.value = true;
};

// 保存设置
const saveSettings = async () => {
    try {
        // 将响应式对象转换为普通对象
        const settingsData = JSON.parse(JSON.stringify(settings.value));

        const result = await window.$mapi.ipAgent.saveSettings({
            settings: settingsData
        });

        if (result && result.success === true) {
            Message.success(t("设置已保存"));
            showSettingsDialog.value = false;
        } else {
            Message.error(result?.message || t("保存设置失败"));
        }
    } catch (error) {
        console.error("保存设置异常:", error);
        Message.error(t("保存设置失败"));
    }
};

// 加载设置
const loadSettings = async () => {
    try {
        const result = await window.$mapi.ipAgent.getSettings();

        if (result.success && result.settings) {
            // 合并设置，保留默认值
            settings.value = {
                ...settings.value,
                ...result.settings
            };
        }
    } catch (error) {
        console.error("加载设置失败:", error);
    }
};

// 选择背景音乐目录
const selectBgmDirectory = async () => {
    try {
